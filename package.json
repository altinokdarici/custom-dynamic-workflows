{
  "name": "custom-dynamic-workflows",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Copilot CLI and Claude Code plugin that turns a task into a graph of steps (p-graph) and runs every step to completion.",
  "license": "MIT",
  "author": "Altinok Darici",
  "homepage": "https://github.com/altinokdarici/custom-dynamic-workflows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altinokdarici/custom-dynamic-workflows.git"
  },
  "bugs": {
    "url": "https://github.com/altinokdarici/custom-dynamic-workflows/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/mcp.ts src/hook.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --out-extension:.js=.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "dependencies": {
    "@altinok/p-graph": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
